# RAAHAT backend configuration. Copy to .env and fill in. Never commit .env.
# Every value here stays on the host; none of it is sent to the browser.

# --- Required -----------------------------------------------------------------
ENVIRONMENT=production
# Database password for the bundled PostgreSQL container.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
POSTGRES_PASSWORD=
# Signs access tokens. At least 32 random characters.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
RAAHAT_SECRET_KEY=
# Exact origin(s) of the deployed frontend, comma-separated. No wildcards.
# Example: https://raahat-ops.vercel.app
CORS_ALLOWED_ORIGINS=

# --- Network ------------------------------------------------------------------
# Host port the API is published on (loopback only).
API_PORT=8000
# Honour X-Forwarded-For from the local tunnel agent for rate limiting.
TRUST_FORWARDED_HEADERS=true
# Allow unauthenticated citizen reports at /api/v1/public (rate limited).
PUBLIC_INTAKE_ENABLED=false

# --- Sessions and limits --------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=1800
SESSION_MAX_SECONDS=43200
LOGIN_RATE_PER_MINUTE=10
MAX_FAILED_LOGINS=5
LOCKOUT_SECONDS=900

# --- Speech recognition (Gnani Prisma via api.vachana.ai) ---------------------
# Leave empty if not provisioned: audio reports are stored and flagged as
# untranscribed; nothing is invented.
GNANI_API_KEY_TTS_STT=

# --- Translation and extraction model ------------------------------------------
# none | evon | gemini. With none, rule-based extraction still runs and no
# translation is produced.
LLM_PROVIDER=none
# Gnani Evon behind an OpenAI-compatible endpoint (vLLM, TGI or a gateway).
EVON_API_BASE=
EVON_API_KEY=
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
# Google Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Geospatial services ----------------------------------------------------------
# none | nominatim. The public Nominatim service allows light, interactive
# use only (1 request/second, identified client). Lookups run only when an
# operator asks for one.
GEOCODER_PROVIDER=none
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# none | osrm. Needs your own OSRM server; the public demo server is not for
# operational use.
ROUTING_PROVIDER=none
OSRM_BASE_URL=
# Sent with every outbound request so providers can identify this deployment.
HTTP_USER_AGENT=RAAHAT/0.3 (self-hosted emergency coordination)

# --- Official alerts -------------------------------------------------------------
# RSS index of CAP messages, polled every 5 minutes by the worker. NDMA SACHET
# publishes one per state, e.g.
#   https://sachet.ndma.gov.in/cap_public_website/rss/rss_kerala.xml
#   https://sachet.ndma.gov.in/cap_public_website/rss/rss_goa.xml
#   https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml (all India)
CAP_ALERT_FEED_URL=

# --- Duplicate detection --------------------------------------------------------
# Matches scoring at least this are held for operator review.
DEDUP_REVIEW_THRESHOLD=0.40
# Above 1.0 means never attach reports automatically (recommended).
DEDUP_AUTO_LINK_THRESHOLD=1.01

# --- Worker -----------------------------------------------------------------------
WORKER_TICK_SECONDS=2
WORKER_BATCH_SIZE=5
