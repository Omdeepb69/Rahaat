# ==============================================================================
# Raahat 2.0 Deployment Environment Configuration
# Copy this file to .env before starting: cp .env.example .env
# ==============================================================================

# Database Configuration (PostgreSQL 16 + PostGIS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=raahat

# Public Exposure Ports (Nginx Gateway, Prometheus, Grafana)
# Note: Internal PostgreSQL database port (5432) is deliberately NOT exposed to host.
PORT_HTTP=8080
PORT_PROMETHEUS=9090
PORT_GRAFANA=3000

# Grafana Administration
GRAFANA_ADMIN_PASSWORD=raahat_admin

# Application Server
ENVIRONMENT=production
WEB_CONCURRENCY=2
LOG_LEVEL=info
SQL_ECHO=false
