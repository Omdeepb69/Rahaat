# Public URL of the RAAHAT API (the HTTPS tunnel hostname in deployment).
# Only public, non-secret values belong here: everything VITE_* is compiled
# into the browser bundle.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Map tiles. The default is the OpenStreetMap standard tile server, which is
# for light use only (https://operations.osmfoundation.org/policies/tiles/).
# Point this at a tile provider you have an agreement with for operations.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
